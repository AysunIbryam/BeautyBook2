@model BeautyBook.Data.Models.Service

@{
    ViewData["Title"] = "Детайли за услуга";
}

<h1>@Model.Name</h1>

<hr />

<div class="card shadow-sm">
    <div class="card-body">
        <h5>Информация за услугата</h5>

        <p>
            <strong>Категория:</strong>
            @Model.Category.Name
        </p>

        <p>
            <strong>Описание:</strong>
            @(Model.Description ?? "Няма описание.")
        </p>

        <p>
            <strong>Цена:</strong>
            @Model.Price.ToString("0.00") евро.
        </p>

        <p>
            <strong>Продължителност:</strong>
            @Model.DurationMinutes минути
        </p>

        <a asp-controller="Categories"
           asp-action="Details"
           asp-route-id="@Model.CategoryId"
           class="btn btn-outline-secondary">
            Назад към категорията
        </a>

        <a asp-controller="Services"
           asp-action="Index"
           class="btn btn-secondary">
            Всички услуги
        </a>
    </div>
</div>
