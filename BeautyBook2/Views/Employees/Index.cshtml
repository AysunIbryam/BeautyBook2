@model IEnumerable<BeautyBook.Data.Models.Models.Employee>

@{
    ViewData["Title"] = "Нашият екип";
}

<h1>Нашият екип</h1>

<p>Запознайте се със специалистите, които се грижат за вас.</p>

@foreach (var group in Model.GroupBy(e => e.Category.Name))
{
    <h3 class="mt-4">@group.Key</h3>

    <div class="row">
        @foreach (var employee in group)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@employee.FullName</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@employee.Position</h6>
                        <p class="card-text">@employee.Bio</p>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (!Model.Any())
{
    <p>Все още няма добавени служители.</p>
}