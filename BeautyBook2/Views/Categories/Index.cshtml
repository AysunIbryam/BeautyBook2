@model IEnumerable<BeautyBook.Data.Models.Category>

@{
    ViewData["Title"] = "Категории";
}

<h1>Категории услуги</h1>

<p>Разгледайте категориите и изберете услугите, които ви интересуват.</p>

<div class="row">
    @foreach (var category in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@category.Name</h5>

                    <a asp-controller="Categories"
                       asp-action="Details"
                       asp-route-id="@category.Id"
                       class="btn btn-primary">
                        Разгледай услугите
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <p>Все още няма добавени категории.</p>
}
