@model BeautyBook.Web.ViewModels.PaginationViewModel

@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    Dictionary<string, string> RouteFor(int page)
    {
        var values = new Dictionary<string, string>(Model.RouteValues)
        {
            ["page"] = page.ToString()
        };

        return values;
    }

    var first = Math.Max(1, Model.Page - 2);
    var last = Math.Min(Model.TotalPages, Model.Page + 2);
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="Страници">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="@action"
                   asp-all-route-data="RouteFor(Model.Page - 1)">
                    Предишна
                </a>
            </li>

            @for (var i = first; i <= last; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link"
                       asp-action="@action"
                       asp-all-route-data="RouteFor(i)">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="@action"
                   asp-all-route-data="RouteFor(Model.Page + 1)">
                    Следваща
                </a>
            </li>
        </ul>
    </nav>
}