@using BeautyBook.Web.ViewModels

@model CreateAppointmentViewModel

@{
    ViewData["Title"] = "Редактиране на час";
}

<h1>Редактиране на час</h1>
<p>Промени данните за своето записване.</p>
<hr />

<div class="row">
    <div class="col-md-6">
        <form id="appointment-form"
              asp-action="Edit"
              asp-route-id="@ViewContext.RouteData.Values["id"]"
              method="post"
              data-employees-url="@Url.Action("EmployeesByService", "Appointments")"
              data-slots-url="@Url.Action("AvailableSlots", "Appointments")">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="ServiceId" class="form-label">
                    Услуга
                </label>
                <select asp-for="ServiceId"
                        asp-items="Model.Services"
                        class="form-select">
                    <option value="">-- Избери услуга --</option>
                </select>
                <span asp-validation-for="ServiceId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EmployeeId" class="form-label">
                    Служител
                </label>
                <select asp-for="EmployeeId"
                        class="form-select"
                        data-selected="@Model.EmployeeId">
                    <option value="">-- Първо избери услуга --</option>
                </select>
                <span asp-validation-for="EmployeeId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Date" class="form-label">
                    Дата
                </label>
                <input asp-for="Date"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="Date"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StartTime" class="form-label">
                    Начален час
                </label>
                <select asp-for="StartTime"
                        class="form-select"
                        data-selected="@Model.StartTime">
                    <option value="@Model.StartTime">
                        @Model.StartTime
                    </option>
                </select>
                <span asp-validation-for="StartTime"
                      class="text-danger"></span>
                <small class="form-text text-muted">
                    При промяна на датата, услугата или служителя избери свободен час.
                </small>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label">
                    Бележки
                </label>
                <textarea asp-for="Notes"
                          class="form-control"
                          rows="3"></textarea>
                <span asp-validation-for="Notes"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Запази промените
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Отказ
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/appointment-form.js" asp-append-version="true"></script>
}