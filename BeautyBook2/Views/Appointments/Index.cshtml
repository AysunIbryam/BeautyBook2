@model IEnumerable<BeautyBook.Data.Models.Appointment>

@{
    ViewData["Title"] = "Моите часове";
}

<h1>Моите часове</h1>

<p>Тук можеш да видиш своите записвания.</p>

<p>
    <a asp-controller="Appointments"
       asp-action="Create"
       class="btn btn-primary">
        Запази нов час
    </a>
</p>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Услуга</th>
                    <th>Начало</th>
                    <th>Край</th>
                    <th>Бележка</th>
                    <th>Действия</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var appointment in Model)
                {
                    <tr>
                        <td>
                            @(appointment.Service?.Name ?? "Няма услуга")
                        </td>

                        <td>
                            @appointment.StartTime.ToString("dd.MM.yyyy HH:mm")
                        </td>

                        <td>
                            @appointment.EndTime.ToString("dd.MM.yyyy HH:mm")
                        </td>

                        <td>
                            @(appointment.Notes ?? "—")
                        </td>

                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="Details"
                                   asp-route-id="@appointment.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Детайли
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@appointment.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    Редактирай
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@appointment.Id"
                                   class="btn btn-outline-danger btn-sm">
                                    Изтрий
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        Все още нямаш записани часове.
    </div>

    <a asp-controller="Appointments"
       asp-action="Create"
       class="btn btn-primary">
        Запази първия си час
    </a>
}
