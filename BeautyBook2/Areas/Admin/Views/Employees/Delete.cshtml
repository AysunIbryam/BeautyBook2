@model Employee

@{
    ViewData["Title"] = "Изтриване на служител";
    var hasAppointments = (bool)(ViewData["HasAppointments"] ?? false);
}

<h1>Изтриване на служител</h1>
<hr />

<div class="card shadow-sm">
    <div class="card-body">
        <h4>@Model.FullName</h4>
        <p class="text-muted">@Model.Position · @Model.Category.Name</p>

        @if (hasAppointments)
        {
            <div class="alert alert-warning">
                Този служител има свързани резервации и не може да бъде изтрит.
            </div>

            <a asp-action="Index" class="btn btn-secondary">Назад</a>
        }
        else
        {
            <p class="text-danger">Сигурна ли си, че искаш да изтриеш този служител?</p>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger">Изтрий</button>
                <a asp-action="Index" class="btn btn-secondary">Отказ</a>
            </form>
        }
    </div>
</div>