@model IEnumerable<Appointment>

@{
    ViewData["Title"] = "Всички резервации";
}

<h1>Всички резервации</h1>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Клиент</th>
                <th>Услуга</th>
                <th>Начало</th>
                <th>Край</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>
                        @a.User.FirstName @a.User.LastName<br />
                        <small class="text-muted">@a.User.Email</small>
                    </td>
                    <td>@(a.Service?.Name ?? "—")</td>
                    <td>@a.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@a.EndTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@a.Status</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <form asp-action="Confirm" asp-route-id="@a.Id" method="post">
                                <button class="btn btn-success btn-sm">Потвърди</button>
                            </form>
                            <form asp-action="Cancel" asp-route-id="@a.Id" method="post">
                                <button class="btn btn-warning btn-sm">Откажи</button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@a.Id" method="post"
                                  onsubmit="return confirm('Сигурна ли си?');">
                                <button class="btn btn-danger btn-sm">Изтрий</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>