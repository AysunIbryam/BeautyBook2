@model AppointmentsIndexViewModel

@{
    ViewData["Title"] = "Всички резервации";
}

<h1>Всички резервации</h1>

<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-4">
        <select name="status" class="form-select">
            <option value="" selected="@(Model.Status == null)">Всички статуси</option>
            <option value="Pending" selected="@(Model.Status == "Pending")">Чакащи</option>
            <option value="Confirmed" selected="@(Model.Status == "Confirmed")">Потвърдени</option>
            <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Отказани</option>
        </select>
    </div>

    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Филтрирай</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Изчисти</a>
    </div>
</form>

<p class="text-muted">Намерени резервации: @Model.Appointments.TotalItems</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Клиент</th>
                <th>Услуга</th>
                <th>Служител</th>
                <th>Начало</th>
                <th>Край</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Appointments.Items)
            {
                var (badge, text) = a.Status switch
                {
                    "Confirmed" => ("bg-success", "Потвърдена"),
                    "Cancelled" => ("bg-danger", "Отказана"),
                    _ => ("bg-warning text-dark", "Чакаща")
                };

                <tr>
                    <td>
                        @a.User.FirstName @a.User.LastName<br />
                        <small class="text-muted">@a.User.Email</small>
                    </td>
                    <td>@(a.Service?.Name ?? "—")</td>
                    <td>@(a.Employee?.FullName ?? "—")</td>
                    <td>@a.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@a.EndTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td><span class="badge @badge">@text</span></td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            @if (a.Status != "Confirmed")
                            {
                                <form asp-area="Admin" asp-controller="Appointments"
                                      asp-action="Confirm" asp-route-id="@a.Id" method="post">
                                    <button type="submit" class="btn btn-success btn-sm">Потвърди</button>
                                </form>
                            }

                            @if (a.Status != "Cancelled")
                            {
                                <form asp-area="Admin" asp-controller="Appointments"
                                      asp-action="Cancel" asp-route-id="@a.Id" method="post">
                                    <button type="submit" class="btn btn-warning btn-sm">Откажи</button>
                                </form>
                            }

                            <form asp-area="Admin" asp-controller="Appointments"
                                  asp-action="Delete" asp-route-id="@a.Id" method="post"
                                  onsubmit="return confirm('Сигурна ли си?');">
                                <button type="submit" class="btn btn-danger btn-sm">Изтрий</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Appointments.Items.Any())
{
    <div class="alert alert-info">Няма резервации за избрания филтър.</div>
}

<partial name="_Pagination" model="Model.Pagination" />