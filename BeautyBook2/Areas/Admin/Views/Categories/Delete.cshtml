@model Category

@{
    ViewData["Title"] = "Изтриване на категория";
    var hasDependencies = (bool)(ViewData["HasDependencies"] ?? false);
}

<h1>Изтриване на категория</h1>
<hr />

<div class="card shadow-sm">
    <div class="card-body">
        <h4>@Model.Name</h4>

        @if (hasDependencies)
        {
            <div class="alert alert-warning mt-3">
                Тази категория има свързани услуги или служители и не може да бъде изтрита.
            </div>

            <a asp-action="Index" class="btn btn-secondary">Назад</a>
        }
        else
        {
            <p class="text-danger mt-3">Сигурна ли си, че искаш да изтриеш тази категория?</p>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger">Изтрий</button>
                <a asp-action="Index" class="btn btn-secondary">Отказ</a>
            </form>
        }
    </div>
</div>