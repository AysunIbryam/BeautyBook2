@{
    ViewData["Title"] = "Админ панел";
}

<h1>Админ панел</h1>
<p>Управление на BeautyBook.</p>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Резервации</h5>
                <p class="card-text">Преглед, потвърждаване и отказване на всички резервации.</p>
                <a asp-area="Admin"
                   asp-controller="Appointments"
                   asp-action="Index"
                   class="btn btn-primary">
                    Към резервациите
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Услуги</h5>
                <p class="card-text">Добавяне, редактиране и изтриване на услуги.</p>
                <a asp-area="Admin"
                   asp-controller="Services"
                   asp-action="Index"
                   class="btn btn-primary">
                    Към услугите
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Категории</h5>
                <p class="card-text">Управление на категориите услуги.</p>
                <a asp-area="Admin"
                   asp-controller="Categories"
                   asp-action="Index"
                   class="btn btn-primary">
                    Към категориите
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Служители</h5>
                <p class="card-text">Управление на екипа и неговите специалности.</p>
                <a asp-area="Admin"
                   asp-controller="Employees"
                   asp-action="Index"
                   class="btn btn-primary">
                    Към служителите
                </a>
            </div>
        </div>
    </div>
</div>