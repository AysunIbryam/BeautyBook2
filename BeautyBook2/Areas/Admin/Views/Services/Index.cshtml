@model IEnumerable<Service>

@{
    ViewData["Title"] = "Управление на услуги";
}

<h1>Управление на услуги</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Нова услуга</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Назад към панела</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Име</th>
                <th>Категория</th>
                <th>Цена</th>
                <th>Продължителност</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var service in Model.OrderBy(s => s.Category.Name).ThenBy(s => s.Name))
            {
                <tr>
                    <td>@service.Name</td>
                    <td>@service.Category.Name</td>
                    <td>@service.Price.ToString("0.00") €</td>
                    <td>@service.DurationMinutes мин.</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="Edit" asp-route-id="@service.Id"
                               class="btn btn-outline-secondary btn-sm">Редактирай</a>
                            <a asp-action="Delete" asp-route-id="@service.Id"
                               class="btn btn-outline-danger btn-sm">Изтрий</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Все още няма добавени услуги.</div>
}