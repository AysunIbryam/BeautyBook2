@model Service

@{
    ViewData["Title"] = "Изтриване на услуга";
    var hasAppointments = (bool)(ViewData["HasAppointments"] ?? false);
}

<h1>Изтриване на услуга</h1>
<hr />

<div class="card shadow-sm">
    <div class="card-body">
        <h4>@Model.Name</h4>
        <p class="text-muted">Категория: @Model.Category.Name</p>
        <p>Цена: @Model.Price.ToString("0.00") € · @Model.DurationMinutes мин.</p>

        @if (hasAppointments)
        {
            <div class="alert alert-warning">
                Тази услуга има свързани резервации и не може да бъде изтрита.
            </div>

            <a asp-action="Index" class="btn btn-secondary">Назад</a>
        }
        else
        {
            <p class="text-danger">Сигурна ли си, че искаш да изтриеш тази услуга?</p>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger">Изтрий</button>
                <a asp-action="Index" class="btn btn-secondary">Отказ</a>
            </form>
        }
    </div>
</div>
